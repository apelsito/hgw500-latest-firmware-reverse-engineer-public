#!/bin/sh
# OpenMitraStar wired AP controller. RAM state; no flash, NAT or IPv6 writes.
set -u
set -f
umask 077
SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")
FS=${OM_NET_FS_ROOT:-}
PROC=${OM_NET_PROC_ROOT:-${FS}/proc}
SYS=${OM_NET_SYS_ROOT:-${FS}/sys}
STATE=${OM_NET_STATE_ROOT:-${FS}/run/openmitrastar/net}
IP=${OM_NET_IP_BIN:-ip}
BRCTL=${OM_NET_BRCTL_BIN:-brctl}
IW=${OM_NET_IW_BIN:-iw}
UDHCPC=${OM_NET_UDHCPC_BIN:-$(dirname -- "$SELF")/om-net-udhcpc}
UDHCPD=${OM_NET_UDHCPD_BIN:-$(dirname -- "$SELF")/om-net-udhcpd}
SETSID=${OM_NET_SETSID_BIN:-setsid}
ARPING=${OM_NET_ARPING_BIN:-arping}
DHCP_HOOK=${OM_NET_DHCP_HOOK:-$(dirname -- "$SELF")/om-net-dhcp}
RESOLV=${FS}/etc/resolv.conf
LOCAL_CONFIG=${FS}/etc/udhcpd-wlan.conf
MODE_PROVIDER=${FS}/run/openmitrastar/network-mode
LOCKED=0

error() { printf 'OM_NET_ERROR=%s\n' "$*" >&2; return 1; }
valid_path() { case "$1" in /*) case "$1" in *[!A-Za-z0-9_./-]*|*/../*|*/..|*//*) return 1;; esac;; *) return 1;; esac; }
valid_if() { case "$1" in ''|*[!A-Za-z0-9_-]*) return 1;; esac; [ "${#1}" -le 8 ]; }
valid_number() { case "$1" in ''|*[!0-9]*) return 1;; esac; [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
valid_ip() {
 case "$1" in ''|*[!0-9.]*) return 1;; esac
 printf '%s\n' "$1" | awk -F. 'NF!=4{exit 1}{for(i=1;i<=4;i++)if($i!~/^[0-9]+$/||$i>255||(length($i)>1&&substr($i,1,1)=="0"))exit 1}'
}
valid_cidr() { case "$1" in */*) c_ip=${1%/*}; c_prefix=${1#*/};; *) return 1;; esac; valid_ip "$c_ip" && valid_number "$c_prefix" 8 32; }
now() { date +%s; }
pause() {
 sleep "$1" & sleeper=$!
 trap 'kill "$sleeper" 2>/dev/null || :; release; exit 0' HUP INT TERM
 wait "$sleeper"
 sleeper=''
}
put() { printf '%s\n' "$2" > "$STATE/$1.tmp" && mv "$STATE/$1.tmp" "$STATE/$1"; }
get() { [ -r "$STATE/$1" ] && cat "$STATE/$1" || :; }
release() { if [ "$LOCKED" = 1 ]; then rm -f "$STATE/lock/pid"; rmdir "$STATE/lock" 2>/dev/null || :; LOCKED=0; fi; }
lock() {
 mkdir -p "$STATE" || return 1
 n=0
 while ! mkdir "$STATE/lock" 2>/dev/null; do
  n=$((n+1)); [ "$n" -le 100 ] || { error lock-timeout; return 1; }
  owner=$(cat "$STATE/lock/pid" 2>/dev/null || :)
  if valid_number "$owner" 1 2147483647 && ! kill -0 "$owner" 2>/dev/null; then
   rm -f "$STATE/lock/pid"; rmdir "$STATE/lock" 2>/dev/null || :
  fi
  sleep 0.1
 done
 printf '%s\n' "$$" > "$STATE/lock/pid"; LOCKED=1
 trap release 0
 trap 'release; exit 1' HUP INT TERM
}

load_config() {
 MODE=AP; BRIDGE=br0; ETH_PORTS=eth0,eth1; WIFI_PORTS=wlan0; HOSTNAME=hgw500
 LEGACY_BRIDGE_CIDR=192.168.1.90/24; LEGACY_WIFI_CIDR=192.168.73.1/24
 ISOLATED_TEST=0; KEEP_LEGACY_UNTIL_BOUND=0; FALLBACK_CIDR=none
 WATCHDOG_SECONDS=90; ROUTE_METRIC=420; REPORT_CONSOLE=1
 config=$1; [ -f "$config" ] && [ ! -L "$config" ] || { error config-not-regular; return 1; }
 seen=' '
 while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in ''|'#'*) continue;; *=*) key=${line%%=*}; value=${line#*=};; *) error config-syntax; return 1;; esac
  case "$seen" in *" $key "*) error duplicate-config-key; return 1;; esac
  seen="$seen$key "
  case "$key" in
   MODE) MODE=$value;; BRIDGE) BRIDGE=$value;; ETH_PORTS) ETH_PORTS=$value;; WIFI_PORTS) WIFI_PORTS=$value;; HOSTNAME) HOSTNAME=$value;;
   LEGACY_BRIDGE_CIDR) LEGACY_BRIDGE_CIDR=$value;; LEGACY_WIFI_CIDR) LEGACY_WIFI_CIDR=$value;;
   ISOLATED_TEST) ISOLATED_TEST=$value;; KEEP_LEGACY_UNTIL_BOUND) KEEP_LEGACY_UNTIL_BOUND=$value;;
   FALLBACK_CIDR) FALLBACK_CIDR=$value;; WATCHDOG_SECONDS) WATCHDOG_SECONDS=$value;; ROUTE_METRIC) ROUTE_METRIC=$value;; REPORT_CONSOLE) REPORT_CONSOLE=$value;;
   *) error unknown-config-key; return 1;;
  esac
 done < "$config"
 case "$MODE" in AP|VIDEOBRIDGE) :;; *) error invalid-mode; return 1;; esac
 case "$action" in stage|preflight|plan)
  if [ -f "$MODE_PROVIDER" ] && [ ! -L "$MODE_PROVIDER" ]; then
   provider=$(cat "$MODE_PROVIDER")
   case "$provider" in AP|VIDEOBRIDGE) MODE=$provider;; *) error invalid-mode-provider; return 1;; esac
  fi;;
 esac
 [ "$MODE" = AP ] || { error videobridge-backend-unavailable; return 1; }
 valid_if "$BRIDGE" || { error invalid-bridge; return 1; }
 case "$HOSTNAME" in ''|*[!A-Za-z0-9-]*|-*|*-) error invalid-hostname; return 1;; esac
 [ "${#HOSTNAME}" -le 63 ] || return 1
 case "$ISOLATED_TEST:$KEEP_LEGACY_UNTIL_BOUND" in 0:0|1:0|1:1) :;; *) error legacy-requires-isolated-test; return 1;; esac
 case "$REPORT_CONSOLE" in 0|1) :;; *) error invalid-console-report; return 1;; esac
 valid_cidr "$LEGACY_BRIDGE_CIDR" && valid_cidr "$LEGACY_WIFI_CIDR" || { error invalid-legacy-cidr; return 1; }
 valid_number "$WATCHDOG_SECONDS" 10 600 && valid_number "$ROUTE_METRIC" 100 30000 || { error invalid-timing-or-metric; return 1; }
 if [ "$FALLBACK_CIDR" != none ]; then
  valid_cidr "$FALLBACK_CIDR" || return 1
  case "$FALLBACK_CIDR" in 169.254.*.*/16) :;; *) error fallback-must-be-link-local; return 1;; esac
  third=$(printf '%s\n' "$FALLBACK_CIDR" | cut -d. -f3)
  valid_number "$third" 1 254 || { error reserved-link-local; return 1; }
 fi
 PORTS=''; seen_ports=' '
 for list in "$ETH_PORTS" "$WIFI_PORTS"; do
  case "$list" in ''|,*|*,|*,,*|*[!A-Za-z0-9_,-]*) error invalid-ports; return 1;; esac
  save_ifs=$IFS; IFS=,; set -- $list; IFS=$save_ifs
  for port do
   valid_if "$port" && [ "$port" != "$BRIDGE" ] || { error invalid-port; return 1; }
   case "$seen_ports" in *" $port "*) error duplicate-port; return 1;; esac
   seen_ports="$seen_ports$port "; PORTS="$PORTS $port"
  done
 done
 [ "$(printf '%s\n' "$PORTS" | wc -w)" -le 4 ] || { error too-many-ports; return 1; }
}
canonical_config() {
 for key in MODE BRIDGE ETH_PORTS WIFI_PORTS HOSTNAME LEGACY_BRIDGE_CIDR LEGACY_WIFI_CIDR ISOLATED_TEST KEEP_LEGACY_UNTIL_BOUND FALLBACK_CIDR WATCHDOG_SECONDS ROUTE_METRIC REPORT_CONSOLE; do
  case "$key" in MODE) value=$MODE;; BRIDGE) value=$BRIDGE;; ETH_PORTS) value=$ETH_PORTS;; WIFI_PORTS) value=$WIFI_PORTS;; HOSTNAME) value=$HOSTNAME;; LEGACY_BRIDGE_CIDR) value=$LEGACY_BRIDGE_CIDR;; LEGACY_WIFI_CIDR) value=$LEGACY_WIFI_CIDR;; ISOLATED_TEST) value=$ISOLATED_TEST;; KEEP_LEGACY_UNTIL_BOUND) value=$KEEP_LEGACY_UNTIL_BOUND;; FALLBACK_CIDR) value=$FALLBACK_CIDR;; WATCHDOG_SECONDS) value=$WATCHDOG_SECONDS;; ROUTE_METRIC) value=$ROUTE_METRIC;; REPORT_CONSOLE) value=$REPORT_CONSOLE;; esac
  printf '%s=%s\n' "$key" "$value"
 done
}
link_line() { "$IP" -o link show dev "$1"; }
master_of() { link_line "$1" | awk '{for(i=1;i<NF;i++)if($i=="master"){print $(i+1);exit}}'; }
is_up() { link_line "$1" | awk '{for(i=1;i<=NF;i++)if($i~/^</&&$i~/(<|,)UP(,|>)/)found=1}END{exit !found}'; }
has_cidr() { "$IP" -4 -o addr show dev "$1" | awk -v cidr="$2" '$3=="inet"&&$4==cidr{found=1}END{exit !found}'; }
has_labelled() { "$IP" -4 -o addr show dev "$1" | awk -v cidr="$2" -v label="$3" '$3=="inet"&&$4==cidr{for(i=5;i<=NF;i++)if($i==label)found=1}END{exit !found}'; }
proc_command() { [ -r "$PROC/$1/cmdline" ] && tr '\000' ' ' < "$PROC/$1/cmdline" || :; }
alive() {
 valid_number "$1" 1 2147483647 || return 1
 if [ -r "$PROC/$1/stat" ] && [ "$(awk '{print $3}' "$PROC/$1/stat")" = Z ]; then return 1; fi
 kill -0 "$1" 2>/dev/null
}
local_server_pids() {
 set +f
 for file in "$PROC"/[0-9]*/cmdline; do
  [ -r "$file" ] || continue; pid=${file%/cmdline}; pid=${pid##*/}; alive "$pid" || continue
  command=" $(proc_command "$pid") "
  case "$command" in *' udhcpd '*) case "$command" in *" $LOCAL_CONFIG "*) printf '%s\n' "$pid";; esac;; esac
 done
 set -f
}
client_owned() {
 pid=$(get client.pid); alive "$pid" || return 1
 command=" $(proc_command "$pid") "
 case "$command" in *" -i $BRIDGE "*) case "$command" in *" -s $DHCP_HOOK "*) case "$command" in *" -p $STATE/client.pid "*) return 0;; esac;; esac;; esac
 return 1
}
preflight() {
 for tool in "$IP" "$BRCTL" "$IW" "$UDHCPC" "$SETSID"; do command -v "$tool" >/dev/null 2>&1 || { error missing-tool; return 1; }; done
 [ -x "$DHCP_HOOK" ] || { error missing-dhcp-hook; return 1; }
 [ ! -L "$RESOLV" ] && { [ ! -e "$RESOLV" ] || [ -f "$RESOLV" ]; } || { error resolver-not-regular; return 1; }
 for file in "$PROC/sys/net/ipv4/ip_forward" "$PROC/sys/net/ipv6/conf/all/forwarding"; do
  [ ! -r "$file" ] || [ "$(cat "$file")" = 0 ] || { error existing-routing-enabled; return 1; }
 done
 [ -r "$PROC/sys/net/ipv4/ip_forward" ] || { error missing-ipv4-forwarding-state; return 1; }
 for port in $PORTS; do
  link_line "$port" >/dev/null 2>&1 || { error missing-port; return 1; }
  master=$(master_of "$port")
  [ -z "$master" ] || [ "$master" = "$BRIDGE" ] || { error port-owned-by-other-bridge; return 1; }
  for cidr in $("$IP" -4 -o addr show dev "$port" | awk '$3=="inet"{print $4}'); do
   case ",$WIFI_PORTS," in *",$port,"*) [ "$cidr" = "$LEGACY_WIFI_CIDR" ] || { error unknown-ipv4-on-port; return 1; };; *) error unknown-ipv4-on-port; return 1;; esac
  done
 done
 if link_line "$BRIDGE" >/dev/null 2>&1; then
  [ -d "$SYS/class/net/$BRIDGE/bridge" ] || { error existing-name-is-not-bridge; return 1; }
  for cidr in $("$IP" -4 -o addr show dev "$BRIDGE" | awk '$3=="inet"{print $4}'); do [ "$cidr" = "$LEGACY_BRIDGE_CIDR" ] || { error unknown-ipv4-on-bridge; return 1; }; done
 fi
 for port in $(printf '%s' "$WIFI_PORTS" | tr ',' ' '); do "$IW" dev "$port" info | grep -q 'type AP' || { error wireless-port-is-not-ap; return 1; }; done
 servers=$(local_server_pids)
 [ "$(printf '%s\n' "$servers" | awk 'NF{n++}END{print n+0}')" -le 1 ] || { error ambiguous-local-dhcp-server; return 1; }
 if [ -n "$servers" ]; then
  command -v "$UDHCPD" >/dev/null 2>&1 || { error cannot-restore-local-dhcp-server; return 1; }
  for port in $(printf '%s' "$WIFI_PORTS" | tr ',' ' '); do [ -z "$(master_of "$port")" ] || { error original-dhcp-server-already-bridged; return 1; }; done
 fi
 set +f
 for file in "$PROC"/[0-9]*/cmdline; do
  [ -r "$file" ] || continue; pid=${file%/cmdline}; pid=${pid##*/}; alive "$pid" || continue; command=" $(proc_command "$pid") "
  case "$command" in *' udhcpc '*) case "$command" in *" -i $BRIDGE "*) set -f; error existing-dhcp-client-on-bridge; return 1;; esac;; esac
 done
 set -f
 [ "$FALLBACK_CIDR" = none ] || command -v "$ARPING" >/dev/null 2>&1 || { error fallback-needs-arping; return 1; }
}
snapshot() {
 canonical_config > "$STATE/config.tmp" && mv "$STATE/config.tmp" "$STATE/config" || return 1
 mkdir -p "$STATE/snapshot" || return 1
 if link_line "$BRIDGE" >/dev/null 2>&1; then printf '1\n'; else printf '0\n'; fi > "$STATE/snapshot/bridge.exists"
 for port in "$BRIDGE" $PORTS; do
  master_of "$port" > "$STATE/snapshot/$port.master" 2>/dev/null || :
  if is_up "$port" 2>/dev/null; then printf '1\n'; else printf '0\n'; fi > "$STATE/snapshot/$port.up"
 done
 if has_cidr "$BRIDGE" "$LEGACY_BRIDGE_CIDR" 2>/dev/null; then printf '1\n'; else printf '0\n'; fi > "$STATE/snapshot/legacy.bridge"
 for port in $(printf '%s' "$WIFI_PORTS" | tr ',' ' '); do
  if has_cidr "$port" "$LEGACY_WIFI_CIDR"; then printf '1\n'; else printf '0\n'; fi > "$STATE/snapshot/$port.legacy"
 done
 local_server_pids > "$STATE/snapshot/local-server.pid"
}
stop_local_server() {
 pid=$(cat "$STATE/snapshot/local-server.pid"); [ -n "$pid" ] || return 0
 command=" $(proc_command "$pid") "
 case "$command" in *' udhcpd '*) case "$command" in *" $LOCAL_CONFIG "*) :;; *) error local-server-identity-changed; return 1;; esac;; *) return 0;; esac
 kill "$pid" 2>/dev/null || return 1
 n=0; while alive "$pid"; do n=$((n+1)); [ "$n" -lt 30 ] || { error local-dhcp-server-did-not-stop; return 1; }; sleep 0.1; done
}
remove_route() { [ -z "$1" ] || "$IP" route del default via "$1" dev "$BRIDGE" metric "$ROUTE_METRIC" proto 16 >/dev/null 2>&1 || :; }
remove_address() { [ -z "$1" ] || ! has_labelled "$BRIDGE" "$1" "$2" || "$IP" addr del "$1" dev "$BRIDGE"; }
dns_update() {
 mkdir -p "$(dirname -- "$RESOLV")" || return 1
 [ ! -L "$RESOLV" ] && { [ ! -e "$RESOLV" ] || [ -f "$RESOLV" ]; } || return 1
 source=$RESOLV; [ -f "$source" ] || source=/dev/null
 awk 'BEGIN{inside=0;bad=0} $0=="# om-net begin"{if(inside)bad=1;inside=1;next} $0=="# om-net end"{if(!inside)bad=1;inside=0;next} !inside{print} END{if(inside||bad)exit 1}' "$source" > "$STATE/resolver.base" || { error corrupt-owned-dns-block; return 1; }
 : > "$STATE/resolver.new"
 if [ -n "$1" ]; then
  printf '# om-net begin\n' > "$STATE/resolver.new"
  for server in $1; do printf 'nameserver %s\n' "$server" >> "$STATE/resolver.new"; done
  [ -z "$2" ] || printf 'search %s\n' "$2" >> "$STATE/resolver.new"
  printf '# om-net end\n' >> "$STATE/resolver.new"
 fi
 cat "$STATE/resolver.base" >> "$STATE/resolver.new"
 chmod 644 "$STATE/resolver.new" && mv "$STATE/resolver.new" "$RESOLV"
}
lease_clear() {
 old_cidr=$(get lease.cidr); old_gateway=$(get lease.gateway)
 [ -z "$old_cidr" ] || valid_cidr "$old_cidr" || { error corrupt-owned-lease; return 1; }
 [ -z "$old_gateway" ] || valid_ip "$old_gateway" || return 1
 remove_route "$old_gateway"; remove_address "$old_cidr" "$BRIDGE:omnet" || return 1
 dns_update '' '' || return 1
 put lease.cidr ''; put lease.gateway ''; put lease.dns ''; put lease.domain ''; put lease.state WAITING
}
fallback_on() {
 [ "$FALLBACK_CIDR" != none ] || return 0
 if [ "$(get fallback.cidr)" = "$FALLBACK_CIDR" ] && has_labelled "$BRIDGE" "$FALLBACK_CIDR" "$BRIDGE:omll"; then return 0; fi
 if has_cidr "$BRIDGE" "$FALLBACK_CIDR"; then error fallback-address-unowned; return 1; fi
 "$ARPING" -D -q -I "$BRIDGE" -c 2 -w 3 "${FALLBACK_CIDR%/*}" || { error fallback-address-conflict; return 1; }
 "$IP" addr add "$FALLBACK_CIDR" dev "$BRIDGE" label "$BRIDGE:omll" && put fallback.cidr "$FALLBACK_CIDR"
}
fallback_off() { fallback=$(get fallback.cidr); [ -z "$fallback" ] || valid_cidr "$fallback" || return 1; remove_address "$fallback" "$BRIDGE:omll" && put fallback.cidr ''; }
mask_prefix() {
 valid_ip "$1" || return 1
 printf '%s\n' "$1" | awk -F. 'BEGIN{bits=0;partial=0} {for(i=1;i<=4;i++){v=$i;if(partial&&v!=0)exit 1;if(v==255)b=8;else if(v==254)b=7;else if(v==252)b=6;else if(v==248)b=5;else if(v==240)b=4;else if(v==224)b=3;else if(v==192)b=2;else if(v==128)b=1;else if(v==0)b=0;else exit 1;bits+=b;if(v!=255)partial=1}if(bits<8)exit 1;print bits}'
}
lease_restore() {
 new_cidr=$1; new_gateway=$2; old_cidr=$3; old_gateway=$4; old_dns=$5; old_domain=$6
 remove_route "$new_gateway"; remove_address "$new_cidr" "$BRIDGE:omnet" || :
 if [ -n "$old_cidr" ] && ! has_labelled "$BRIDGE" "$old_cidr" "$BRIDGE:omnet"; then "$IP" addr add "$old_cidr" dev "$BRIDGE" label "$BRIDGE:omnet" || :; fi
 [ -z "$old_gateway" ] || "$IP" route add default via "$old_gateway" dev "$BRIDGE" metric "$ROUTE_METRIC" proto 16 || :
 dns_update "$old_dns" "$old_domain" || :
 if [ "$(cat "$STATE/snapshot/legacy.bridge")" = 1 ] && [ "$KEEP_LEGACY_UNTIL_BOUND" = 1 ] && ! has_cidr "$BRIDGE" "$LEGACY_BRIDGE_CIDR"; then "$IP" addr add "$LEGACY_BRIDGE_CIDR" dev "$BRIDGE" || :; fi
}
lease_apply() {
 new_ip=${ip:-}; new_mask=${subnet:-}; new_gateway=''; new_dns=''; new_domain=${domain:-}
 valid_ip "$new_ip" || { error invalid-dhcp-ip; return 1; }
 prefix=$(mask_prefix "$new_mask") || { error invalid-dhcp-mask; return 1; }
 for gateway in ${router:-}; do valid_ip "$gateway" || { error invalid-dhcp-router; return 1; }; [ -n "$new_gateway" ] || new_gateway=$gateway; done
 count=0; for server in ${dns:-}; do valid_ip "$server" || { error invalid-dhcp-dns; return 1; }; count=$((count+1)); [ "$count" -le 6 ] || return 1; new_dns="${new_dns}${new_dns:+ }$server"; done
 case "$new_domain" in *[!A-Za-z0-9.-]*|.*|*..*|*.) error invalid-dhcp-domain; return 1;; esac
 [ "${#new_domain}" -le 253 ] || return 1
 duration=${lease:-3600}; valid_number "$duration" 1 604800 || { error invalid-dhcp-lease; return 1; }
 new_cidr=$new_ip/$prefix; old_cidr=$(get lease.cidr); old_gateway=$(get lease.gateway); old_dns=$(get lease.dns); old_domain=$(get lease.domain)
 [ -z "$old_cidr" ] || valid_cidr "$old_cidr" || return 1
 [ -z "$old_gateway" ] || valid_ip "$old_gateway" || return 1
 if [ "$new_cidr" != "$old_cidr" ]; then
  if has_cidr "$BRIDGE" "$new_cidr" && ! has_labelled "$BRIDGE" "$new_cidr" "$BRIDGE:omnet"; then
   if [ "$new_cidr" = "$LEGACY_BRIDGE_CIDR" ] && [ "$(cat "$STATE/snapshot/legacy.bridge")" = 1 ]; then "$IP" addr del "$LEGACY_BRIDGE_CIDR" dev "$BRIDGE" || return 1
   else error offered-address-already-unowned; return 1; fi
  fi
  if ! "$IP" addr add "$new_cidr" dev "$BRIDGE" label "$BRIDGE:omnet"; then lease_restore "$new_cidr" '' "$old_cidr" "$old_gateway" "$old_dns" "$old_domain"; return 1; fi
 fi
 if [ "$new_gateway" != "$old_gateway" ] || [ "$new_cidr" != "$old_cidr" ]; then
  remove_route "$old_gateway"
  if [ -n "$new_gateway" ] && ! "$IP" route add default via "$new_gateway" dev "$BRIDGE" metric "$ROUTE_METRIC" proto 16; then lease_restore "$new_cidr" '' "$old_cidr" "$old_gateway" "$old_dns" "$old_domain"; return 1; fi
 fi
 if ! dns_update "$new_dns" "$new_domain"; then lease_restore "$new_cidr" "$new_gateway" "$old_cidr" "$old_gateway" "$old_dns" "$old_domain"; return 1; fi
 if [ "$new_cidr" != "$old_cidr" ]; then remove_address "$old_cidr" "$BRIDGE:omnet" || return 1; fi
 fallback_off || return 1
 if [ "$(cat "$STATE/snapshot/legacy.bridge")" = 1 ] && [ "$new_cidr" != "$LEGACY_BRIDGE_CIDR" ] && has_cidr "$BRIDGE" "$LEGACY_BRIDGE_CIDR"; then "$IP" addr del "$LEGACY_BRIDGE_CIDR" dev "$BRIDGE" || return 1; fi
 put lease.cidr "$new_cidr"; put lease.gateway "$new_gateway"; put lease.dns "$new_dns"; put lease.domain "$new_domain"; put lease.expires "$(( $(now) + duration ))"; put lease.state BOUND
 if [ "$REPORT_CONSOLE" = 1 ] && [ -w "${FS}/dev/console" ]; then
  timeout 2 sh -c 'printf "OM_NET_BOUND address=%s gateway=%s\n" "$2" "$3" > "$1"' sh "${FS}/dev/console" "$new_cidr" "$new_gateway" || :
 fi
}
start_client() {
 token=$(get transaction)
 OM_NET_TRANSACTION=$token OM_NET_STATE_ROOT=$STATE OM_NET_CONTROLLER=$SELF "$SETSID" "$UDHCPC" -f -i "$BRIDGE" -p "$STATE/client.pid" -s "$DHCP_HOOK" -x "hostname:$HOSTNAME" -a -t 3 -T 3 -A 10 </dev/null >> "$STATE/dhcp.log" 2>&1 &
 put client.pid "$!"
}
rollback_locked() {
 [ -f "$STATE/config" ] && [ -d "$STATE/snapshot" ] || { error no-snapshot; return 1; }
 put status ROLLING_BACK
 failed=0
 if client_owned; then kill "$(get client.pid)" 2>/dev/null || :; fi
 lease_clear || failed=1; fallback_off || failed=1
 for port in $PORTS; do
  if [ "$(master_of "$port")" = "$BRIDGE" ]; then "$BRCTL" delif "$BRIDGE" "$port" || failed=1; fi
  original=$(cat "$STATE/snapshot/$port.master"); [ -z "$original" ] || "$BRCTL" addif "$original" "$port" || failed=1
  if [ "$(cat "$STATE/snapshot/$port.up")" = 1 ]; then "$IP" link set dev "$port" up || failed=1; else "$IP" link set dev "$port" down || failed=1; fi
 done
 for port in $(printf '%s' "$WIFI_PORTS" | tr ',' ' '); do
  if [ "$(cat "$STATE/snapshot/$port.legacy")" = 1 ] && ! has_cidr "$port" "$LEGACY_WIFI_CIDR"; then "$IP" addr add "$LEGACY_WIFI_CIDR" dev "$port" || failed=1; fi
 done
 if [ "$(cat "$STATE/snapshot/legacy.bridge")" = 1 ] && ! has_cidr "$BRIDGE" "$LEGACY_BRIDGE_CIDR"; then "$IP" addr add "$LEGACY_BRIDGE_CIDR" dev "$BRIDGE" || failed=1; fi
 if [ "$(cat "$STATE/snapshot/bridge.exists")" = 0 ]; then "$IP" link set dev "$BRIDGE" down || failed=1; "$BRCTL" delbr "$BRIDGE" || failed=1
 elif [ "$(cat "$STATE/snapshot/$BRIDGE.up")" = 0 ]; then "$IP" link set dev "$BRIDGE" down || failed=1; fi
 if [ -s "$STATE/snapshot/local-server.pid" ] && [ -z "$(local_server_pids)" ]; then
  safe=1
  for port in $(printf '%s' "$WIFI_PORTS" | tr ',' ' '); do [ -z "$(master_of "$port")" ] && has_cidr "$port" "$LEGACY_WIFI_CIDR" || safe=0; done
  if [ "$safe" = 1 ]; then "$SETSID" "$UDHCPD" -f "$LOCAL_CONFIG" </dev/null >> "$STATE/rollback-dhcp.log" 2>&1 & else failed=1; error refusing-dhcp-server-on-bridged-lan; fi
 fi
 put lease.state STOPPED
 if [ "$failed" = 0 ]; then put status ROLLED_BACK; else put status ROLLBACK_FAILED; error rollback-incomplete; return 1; fi
}
stage() {
 case "$(get status)" in STAGING|STAGED|COMMITTED|ROLLING_BACK) error existing-transaction-use-commit-or-rollback; return 1;; esac
 preflight || return 1; snapshot || return 1
 token="$(now)-$$"; put transaction "$token"; put status STAGING; put lease.state WAITING
 put lease.cidr ''; put lease.gateway ''; put fallback.cidr ''; put deadline "$(( $(now) + WATCHDOG_SECONDS ))"; put watchdog.seconds "$WATCHDOG_SECONDS"
 "$SETSID" "$SELF" _watchdog "$token" </dev/null >> "$STATE/watchdog.log" 2>&1 & put watchdog.pid "$!"
 if ! stop_local_server; then rollback_locked; error stage-local-server; return 1; fi
 if [ "$(cat "$STATE/snapshot/bridge.exists")" = 0 ]; then "$BRCTL" addbr "$BRIDGE" && "$BRCTL" stp "$BRIDGE" on || { rollback_locked; return 1; }; fi
 for port in $(printf '%s' "$WIFI_PORTS" | tr ',' ' '); do
  if has_cidr "$port" "$LEGACY_WIFI_CIDR"; then "$IP" addr del "$LEGACY_WIFI_CIDR" dev "$port" || { rollback_locked; return 1; }; fi
 done
 for port in $PORTS; do
  [ "$(master_of "$port")" = "$BRIDGE" ] || "$BRCTL" addif "$BRIDGE" "$port" || { rollback_locked; return 1; }
  "$IP" link set dev "$port" up || { rollback_locked; return 1; }
 done
 "$IP" link set dev "$BRIDGE" up || { rollback_locked; return 1; }
 if [ "$KEEP_LEGACY_UNTIL_BOUND" = 0 ] && has_cidr "$BRIDGE" "$LEGACY_BRIDGE_CIDR"; then "$IP" addr del "$LEGACY_BRIDGE_CIDR" dev "$BRIDGE" || { rollback_locked; return 1; }; fi
 fallback_on || { rollback_locked; return 1; }
 put status STAGED; start_client || { rollback_locked; return 1; }
 "$SETSID" "$SELF" _monitor "$token" </dev/null >> "$STATE/monitor.log" 2>&1 & put monitor.pid "$!"
 status
}
status() {
 printf 'OM_NET_SCHEMA=1\nMODE=%s\nBRIDGE=%s\nSTATUS=%s\nTRANSACTION=%s\nLEASE=%s\nADDRESS=%s\nGATEWAY=%s\nDNS_FILE=%s\nCLIENT_PID=%s\nDEADLINE=%s\n' "$MODE" "$BRIDGE" "$(get status)" "$(get transaction)" "$(get lease.state)" "$(get lease.cidr)" "$(get lease.gateway)" "$RESOLV" "$(get client.pid)" "$(get deadline)"
}
dhcp_event() {
 [ "${OM_NET_TRANSACTION:-}" = "$(get transaction)" ] && [ "${interface:-}" = "$BRIDGE" ] || { error stale-or-wrong-interface-hook; return 1; }
 case "$(get status)" in STAGED|COMMITTED) :;; *) error inactive-dhcp-hook; return 1;; esac
 case "$1" in bound|renew) lease_apply;; deconfig|nak|leasefail) lease_clear && fallback_on;; *) error unsupported-dhcp-event; return 1;; esac
}

valid_path "$STATE" && valid_path "$PROC" && valid_path "$SYS" || { error unsafe-runtime-root; exit 1; }
action=${1:-status}; shift || :
case "$action" in
 _watchdog)
  token=${1:-}; seconds=$(get watchdog.seconds); valid_number "$seconds" 10 600 || exit 1; pause "$seconds"
  lock || exit 1; [ "$token" = "$(get transaction)" ] || exit 0
  case "$(get status)" in STAGING|STAGED) load_config "$STATE/config" && rollback_locked;; esac; exit $?;;
 _monitor)
  token=${1:-}
  while :; do
   pause 5; lock || exit 1
   [ "$token" = "$(get transaction)" ] || exit 0
   case "$(get status)" in STAGED|COMMITTED) :;; *) exit 0;; esac
   load_config "$STATE/config" || exit 1
   if ! client_owned; then lease_clear && fallback_on && start_client || :; fi
   release
  done;;
esac
config=$STATE/config
if [ "${1:-}" = --config ]; then [ "$#" = 2 ] || { error usage; exit 1; }; config=$2; fi
load_config "$config" || exit 1
lock || exit 1
case "$action" in
 preflight|plan) preflight && printf 'OM_NET_PREFLIGHT=PASS\nMODE=AP\nBRIDGE=%s\nPORTS=%s\n' "$BRIDGE" "$PORTS";;
 stage) stage;;
 commit)
  [ "$(get status)" = STAGED ] && [ "$(get lease.state)" = BOUND ] && client_owned && has_labelled "$BRIDGE" "$(get lease.cidr)" "$BRIDGE:omnet" && [ -z "$(local_server_pids)" ] || { error commit-needs-bound-owned-lease; exit 1; }
  put status COMMITTED; status;;
 rollback|stop) rollback_locked && status;;
 status) status;;
 _dhcp) dhcp_event "${1:-}";;
 *) error unknown-action; exit 1;;
esac
